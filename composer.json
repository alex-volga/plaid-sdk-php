{
    "name": "alex-volga/plaid-sdk-php",
    "description": "PHP implementation of Plaid's API as an SDK.",
    "keywords": [
        "plaid",
        "sdk",
        "php"
    ],
    "type": "library",
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "nimbly/shuttle": "^1.0"
    },
    "suggest": {
        "ext-curl": "Required when using Shuttle cURL HTTP handler."
    },
    "autoload": {
        "psr-4": {
            "TomorrowIdeas\\Plaid\\" : "src"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "vimeo/psalm": "^5.0 || ^6.0",
        "symfony/var-dumper": "^4.2 || ^5.0 || ^6.0 || ^7.0",
        "php-coveralls/php-coveralls": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "TomorrowIdeas\\Plaid\\Tests\\": "tests"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Brent Scheffler",
            "email": "brent@brentscheffler.com"
        },
        {
            "name": "Alexandr Volga",
            "email": "v.alex.lg@gmail.com"
        }
    ]
}
